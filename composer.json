{
    "name": "galatanovidiu/php-mcp-client",
    "description": "A PHP MCP (Model Context Protocol) client implementation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ovidiu Galatan"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/WordPress/php-mcp-schema"
        }
    ],
    "require": {
        "php": ">=7.4",
        "wordpress/php-mcp-schema": "dev-trunk",
        "psr/log": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "GalatanOvidiu\\PhpMcpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GalatanOvidiu\\PhpMcpClient\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "phpcs": "phpcs src/",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
